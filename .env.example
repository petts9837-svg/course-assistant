# 複製成 .env 並填入自己的值（.env 已列在 .gitignore，不會上傳）
# Copy to .env and fill in your own values. Never commit .env.

# Cloudflare Workers AI（Dashboard → AI → Workers AI → Use REST API）
CF_ACCOUNT_ID=your-account-id
CF_API_TOKEN=your-api-token

# 選填 Optional
# CF_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CF_EMBED_MODEL=@cf/baai/bge-m3
# SEARCH_MIN_COVERAGE=0.5   # course-search：關鍵字至少命中比例
# SEARCH_MIN_SIM=0.55       # course-search：向量相似度門檻
